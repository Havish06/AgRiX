# AgRiX Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=AgRiX
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
# For local development, SQLite is used by default
# For production, use PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./AgRiX.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/AgRiX

# Database Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Data Providers (API Keys - Optional for local development)
# FAOSTAT
FAOSTAT_API_KEY=
FAOSTAT_BASE_URL=https://fenixservices.fao.org/faostat/api/v1

# NOAA Climate Data
NOAA_API_KEY=
NOAA_BASE_URL=https://www.ncei.noaa.gov/access/services/data/v1

# NASA POWER
NASA_POWER_BASE_URL=https://power.lrc.nasa.gov/api

# ERA5 / Copernicus
CDS_API_KEY=
CDS_BASE_URL=https://cds.climate.copernicus.eu/api/v2

# Commodity Prices
ALPHA_VANTAGE_API_KEY=
QUANDL_API_KEY=

# ML/Experiments
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=AgRiX
RANDOM_SEED=42

# Model Registry
MODEL_REGISTRY_PATH=./model_registry

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Cache
CACHE_DIR=./cache
CACHE_TTL_HOURS=24

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]